NODE_ENV=development
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# Legacy Supabase key names remain supported as fallbacks.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://127.0.0.1:6379

# Provider modes are explicit. Development and test also default to mock when
# omitted; production requires both modes to be explicitly set to live.
GOOGLE_MAPS_MODE=mock
GOOGLE_MAPS_SERVER_KEY=

RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use a local-only value in .env when exercising signed webhook tests.
RAZORPAY_WEBHOOK_SECRET=

# Production configuration:
# NODE_ENV=production
# GOOGLE_MAPS_MODE=live              # GOOGLE_MAPS_SERVER_KEY is required
# RAZORPAY_MODE=live                 # all three Razorpay values are required

# Firebase Cloud Messaging. Prefer Application Default Credentials (workload
# identity or GOOGLE_APPLICATION_CREDENTIALS outside the repository). The three
# FIREBASE_* values may instead be supplied together by the deployment secret
# manager; never commit their values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
SENTRY_DSN=
DRIVER_REASSIGN_RPC=auto_assign_nearest_driver
